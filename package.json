{
  "name": "pt-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "db:migrate": "pnpm --filter @pt/api prisma:migrate",
    "db:generate": "pnpm --filter @pt/api prisma:generate",
    "db:studio": "pnpm --filter @pt/api prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  }
}
