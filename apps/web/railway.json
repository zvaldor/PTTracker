{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npx serve@latest out -l 3000",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}
